            },
            {
              "columns": [
                {
                  "formula": "IF(coalesce(Paid,0) &gt; coalesce(Accrued,0), coalesce(Accrued,0) - coalesce(Paid,0),0)",
                  "name": "Writeback"
                },
                {
                  "formula": "coalesce(Opening_Balance,0) + coalesce(Accrued,0) - coalesce(Paid,0) - coalesce(Writeback,0)",
                  "name": "Closing_Balance"
                },
                {
                  "formula": "coalesce(Closing_Balance,0) - coalesce(Opening_Balance,0)",
                  "name": "Change_In_Month"
                },
                {
                  "formula": "coalesce(Accrued,0) - coalesce(Writeback,0)",
                  "name": "Monthly_Expense"

## Bar charts

### hbar

**columnMap keys:** `trellis` (always `[]` unless using small multiples), `dimensionAxis` (dimension field names from step groups), `plots` (measure aliases from step columns)

**Step JSON:**
```json
{
  "type": "aggregateflex",
  "broadcastFacet": true,
  "selectMode": "single",
  "useGlobal": true,
  "isGlobal": false,
  "datasets": [
    {
      "id": "<datasetId>",
      "label": "<Label>",
      "name": "<datasetName>",
      "url": "<url>"
    }
  ],
  "receiveFacetSource": {
    "mode": "all",
    "steps": []
  },
  "query": {
    "limit": 2000,
    "sources": [
      {
        "name": "<datasetName>",
        "groups": [
          "<Name>"
        ],
        "columns": [
          {
            "field": [
              "sum",
              "<A_field>"
            ],
            "name": "A"
          }
        ],
        "filters": [],
        "joins": []
      }
    ],
    "orders": [
      {
        "name": "<Name>",
        "ascending": true,
        "filters": []
      }
    ],
    "aggregateFilters": [],
    "columnGroups": [],
    "columnTotals": [],
    "rowTotals": [],
    "sourceFilters": {}
  },
  "visualizationParameters": {
    "parameters": {},
    "type": "chart"
  }
}
```

**Widget JSON:**
```json
{
  "type": "chart",
  "parameters": {
    "visualizationType": "hbar",
    "step": "<stepId>",
    "columnMap": {
      "trellis": [],
      "dimensionAxis": [
        "Name"
      ],
      "plots": [
        "A"
      ]
    },
    "autoFitMode": "keepLabels",
    "axisMode": "sync",
    "showActionMenu": true,
    "exploreLink": true,
    "binValues": false,
    "theme": "wave",
    "title": {
      "fontSize": 14,
      "subtitleFontSize": 11,
      "label": "",
      "align": "center",
      "subtitleLabel": ""
    },
    "trellis": {
      "enable": false,
      "type": "x",
      "chartsPerLine": 4,
      "flipLabels": false,
      "showGridLines": true,
      "size": [
        100,
        100
      ]
    }
  }
}
```


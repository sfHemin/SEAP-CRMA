## aggregateflex step — compact form 2.0

This is the step type CRMA generates when building via the canvas drag-and-drop.
Use this for all standard aggregate queries.

### Simple single-source step (one dataset, one measure)

```json
"lens_2": {
  "type": "aggregateflex",
  "broadcastFacet": true,
  "selectMode": "single",
  "useGlobal": true,
  "isGlobal": false,
  "datasets": [],
  "cdpObjects": ["accrualoutput_decorated__dlm"],
  "dataspace": "default",
  "receiveFacetSource": { "mode": "all", "steps": [] },
  "query": {
    "limit": 250,
    "sources": [{
      "name": "accrualoutput_decorated__dlm",
      "groups": ["ProductLabel__c"],
      "columns": [
        { "field": ["sum", "OpenAccrual__c"], "name": "B" }
      ],
      "filters": [],
      "joins": []
    }],
    "orders": [{ "name": "ProductLabel__c", "ascending": true, "filters": [] }],
    "aggregateFilters": [],
    "columnGroups": [],
    "columnTotals": [],
    "rowTotals": [],
    "sourceFilters": {}
  },
  "visualizationParameters": {
    "parameters": { <copy widget parameters here> },
    "type": "chart"
  }
}
```

**columnMap wiring:** `sources[0].groups` → `columnMap.dimensionAxis`, `sources[0].columns[].name` → `columnMap.plots`
So for the above: `{ "trellis": [], "dimensionAxis": ["ProductLabel__c"], "plots": ["B"] }`

### Multi-source step (multiple measures with different filters)

Used when you need measures from the same dataset but with different date/condition filters
(e.g. opening balance uses last 18 months, accrued uses current month):

```json
"lens_1": {
  "type": "aggregateflex",
  "broadcastFacet": true,
  "selectMode": "single",
  "useGlobal": true,
  "isGlobal": false,
  "datasets": [],
  "cdpObjects": ["accrualoutput_decorated__dlm"],
  "dataspace": "default",
  "receiveFacetSource": { "mode": "all", "steps": [] },
  "query": {
    "limit": 250,
    "sources": [
      {
        "name": "accrualoutput_decorated__dlm",
        "groups": ["AccountLabel__c", "PromotionLabel__c"],
        "columns": [{ "field": ["sum", "PaidAmount__c"], "name": "Paid" }],
        "filters": [],
        "joins": []
      },
      {
        "name": "accrualoutput_decorated__dlm",
        "groups": ["AccountLabel__c", "PromotionLabel__c"],
        "columns": [{ "field": ["sum", "OpenAccrual__c"], "name": "Opening_Balance" }],
        "filters": [
          ["EffectiveDate__c", [["month", -18], ["month", -1]], "between"]
        ],
        "joins": []
      },
      {
        "name": "accrualoutput_decorated__dlm",
        "groups": ["AccountLabel__c", "PromotionLabel__c"],
        "columns": [{ "field": ["sum", "Value__c"], "name": "Accrued" }],
        "filters": [
          ["EffectiveDate__c", [["month", 0], ["day", 0]], "between"]
        ],
        "joins": []
      },
      {
        "groups": [],
        "joins": [],
        "columns": [
          { "formula": "coalesce(Opening_Balance,0) + coalesce(Accrued,0) - coalesce(Paid,0)", "name": "Closing_Balance" },
          { "formula": "coalesce(Closing_Balance,0) - coalesce(Opening_Balance,0)", "name": "Change_In_Month" }
        ],
        "filters": []
      }
    ],
    "orders": [{ "name": "AccountLabel__c", "ascending": true, "filters": [] }],
    "aggregateFilters": [],
    "columnGroups": [],
    "columnTotals": [],
    "rowTotals": [],
    "sourceFilters": {}
  }
}
```

Note: the last source has no `name` — this is a formula-only source that computes
derived columns from the previously named measure aliases.


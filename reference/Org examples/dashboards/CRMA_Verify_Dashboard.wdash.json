  "steps": {
    "cluster_agg_1": {
      "type": "aggregateflex",
      "label": "By Cluster",
      "datasets": [
        {
          "name": "Clustered_Accounts"
        }
      ],
      "query": {
        "query": "{\"measures\": [[\"sum\", \"AccountLifetimeValue\"]], \"groups\": [\"Cluster\"]}",
        "version": -1
      },
      "broadcastFacet": true,
      "receiveFacetSource": {
        "mode": "all"
      },
      "isGlobal": false,
      "useGlobal": true,
      "selectMode": "single",
      "visualizationParameters": {
        "visualizationType": "hbar"
      },
      "useExternalFilters": true
    },
    "rank_industry_1": {
      "type": "saql",
      "label": "Rank by Industry",
      "query": "q = load \"0FbId000000c7nUKAQ/0FcId000000RGbxKAG\"; q = group q by 'Industry'; q = foreach q generate 'Industry' as 'Industry', sum('AccountLifetimeValue') as 'Lifetime_Value', rank() over([..] partition by all order by sum('AccountLifetimeValue') desc) as 'Rank'; q = order q by 'Rank' asc; q = limit q 10;",
      "strings": [
        "Industry"
      ],
      "numbers": [
        "Lifetime_Value",
        "Rank"
      ],
      "groups": [],
      "broadcastFacet": true,
      "receiveFacetSource": {
        "mode": "all"
      },
      "useGlobal": true,
      "selectMode": "single",
      "useExternalFilters": true
    },
    "kpi_1": {
      "type": "aggregateflex",
      "label": "KPIs",
      "datasets": [
        {
          "name": "Clustered_Accounts"
        }
      ],
      "query": {
        "query": "{\"measures\": [[\"sum\", \"AccountLifetimeValue\"], [\"sum\", \"DealCount\"], [\"avg\", \"AverageDealSize\"]], \"groups\": []}",
        "version": -1
      },
      "broadcastFacet": true,
      "receiveFacetSource": {
        "mode": "all"
      },
      "isGlobal": false,
      "useGlobal": true,
      "selectMode": "single",
      "useExternalFilters": true
    },
    "detail_1": {
      "type": "aggregateflex",
      "label": "Detail",
      "datasets": [
        {
          "name": "Clustered_Accounts"
        }
      ],
      "query": {
        "query": "{\"measures\": [[\"sum\", \"AccountLifetimeValue\"], [\"sum\", \"DealCount\"]], \"groups\": [\"Industry\", \"Cluster\"]}",
        "version": -1
      },
      "broadcastFacet": true,
      "receiveFacetSource": {
        "mode": "all"
      },
      "isGlobal": false,
      "useGlobal": true,
      "selectMode": "single",
      "useExternalFilters": true
    },
    "filter_cluster_1": {
      "type": "aggregateflex",
      "label": "Cluster Filter",
      "datasets": [
        {
          "name": "Clustered_Accounts"
        }
      ],
      "query": {
        "query": "{\"measures\": [[\"count\", \"*\"]], \"groups\": [\"Cluster\"]}",
        "version": -1
      },
      "broadcastFacet": true,
      "isGlobal": true,
      "useGlobal": true,
      "selectMode": "multi",
      "useExternalFilters": true
    },
    "filter_industry_1": {
      "type": "aggregateflex",
      "label": "Industry Filter",
      "datasets": [
        {
          "name": "Clustered_Accounts"
        }
      ],
      "query": {
        "query": "{\"measures\": [[\"count\", \"*\"]], \"groups\": [\"Industry\"]}",
        "version": -1
      },
      "broadcastFacet": true,
      "isGlobal": true,
      "useGlobal": true,
      "selectMode": "multi",
      "useExternalFilters": true
    }
  },

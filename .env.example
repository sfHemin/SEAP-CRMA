# ─────────────────────────────────────────────────────────────────────────────
# CRMA Mastra Copilot — environment template.
# Copy this file to .env and fill in your values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Model provider ────────────────────────────────────────────────────────────
# "gateway"   → Salesforce internal model gateway (LiteLLM proxy, OpenAI-compatible)
# "anthropic" → direct Anthropic API (personal/team key)
LLM_PROVIDER=gateway

# ── Salesforce model gateway (required when LLM_PROVIDER=gateway) ─────────────
SF_GATEWAY_TOKEN=your-gateway-token-here
SF_GATEWAY_BASE_URL=https://your-gateway-host/v1
GATEWAY_MODEL_SONNET=claude-sonnet-4-6
GATEWAY_MODEL_OPUS=claude-opus-4-8-vertex

# If the gateway uses a private TLS chain, point this at the CA bundle PEM.
# NODE_EXTRA_CA_CERTS=/path/to/ca-bundle.pem

# ── Direct Anthropic (required when LLM_PROVIDER=anthropic) ──────────────────
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
ANTHROPIC_MODEL_OPUS=claude-opus-4-8

# ── Salesforce org ────────────────────────────────────────────────────────────
# The alias of the org the agent reads/writes. Must be authenticated:
#   sf org login web --alias my-org
# Then confirm with: sf org list
SF_TARGET_ORG=your-org-alias

# ── Safety: deploy gate ───────────────────────────────────────────────────────
# true  → all deploy/run calls are --dry-run only (safe default)
# false → live writes enabled (set only when you intend to deploy to the org)
DEPLOY_DRY_RUN=true

# ── RAG reference library (optional override) ─────────────────────────────────
# Default: the reference/ folder inside this project (CRMA Mastra/reference/).
# Override only if you move the reference folder elsewhere.
# RAG_REFERENCE_DIR=/absolute/path/to/reference

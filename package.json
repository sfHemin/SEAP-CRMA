{
  "name": "crma-mastra-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CRMA Copilot — a Mastra agent that gets/edits/debugs/creates/deploys CRM Analytics recipes and dashboards via Claude (Salesforce model gateway or direct Anthropic key).",
  "scripts": {
    "ui": "node --env-file=.env src/server.mjs",
    "chat": "node --env-file=.env src/chat.mjs",
    "ask": "node --env-file=.env src/ask.mjs",
    "dev": "mastra dev",
    "postinstall": "node -e \"const {readdirSync,readFileSync,writeFileSync}=require('fs'),{join}=require('path');['node_modules/mastra/dist/studio/assets','.mastra/output/studio/assets'].forEach(dir=>{let files;try{files=readdirSync(dir)}catch{return};files.filter(f=>f.endsWith('.js')&&f.startsWith('main-')).forEach(f=>{const p=join(dir,f);writeFileSync(p,readFileSync(p,'utf8').replace(/maxSteps:15/g,'maxSteps:100'))})});\""
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/openai-compatible": "^3.0.0",
    "@mastra/core": "^1.61.0",
    "@mastra/libsql": "^1.21.1",
    "@mastra/loggers": "^1.2.0",
    "@mastra/memory": "^1.27.0",
    "ai": "^7.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "mastra": "^1.26.0"
  }
}
